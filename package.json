{
  "name": "drastic-client-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "prepare": "husky",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs": "typedoc --tsconfig ./tsconfig.json --options tsconfig.typedoc.json",
    "docs:watch": "typedoc --tsconfig ./tsconfig.json --options tsconfig.typedoc.json --watch",
    "depcheck": "depcheck --specials=eslint,babel,vite,vitest,next",
    "prune:check": "ts-prune -p tsconfig.json --ignore \"src/generated/**\"",
    "prune:ci": "ts-prune -p tsconfig.json --error --ignore \"src/generated/**\""
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "next lint --fix",
      "tsc --noEmit"
    ]
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^4.1.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.13",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-scroll-area": "^1.2.8",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-toggle": "^1.1.8",
    "@radix-ui/react-toggle-group": "^1.1.9",
    "@supabase/auth-helpers-nextjs": "^0.7.4",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.3",
    "@tanstack/react-query": "^5.76.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.484.0",
    "next": "^14.0.0",
    "react": "^18.2.0",
    "react-day-picker": "^9.6.3",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.54.2",
    "sonner": "^2.0.3",
    "swr": "^2.3.3",
    "tailwind-merge": "^3.3.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.8.9",
    "@types/react": "^18.2.33",
    "@types/react-dom": "^18.2.14",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^3.1.4",
    "autoprefixer": "^10.4.16",
    "depcheck": "^1.4.7",
    "eslint": "^8.52.0",
    "eslint-config-next": "^14.0.0",
    "eslint-plugin-vitest": "^0.5.4",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.0.0",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "ts-prune": "^0.10.3",
    "typedoc": "^0.28.1",
    "typescript": "^5.2.2",
    "vitest": "^3.1.4"
  }
}
